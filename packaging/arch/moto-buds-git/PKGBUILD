# Maintainer: Shni <niamelyrz@gmail.com>

pkgname=moto-buds-git
pkgver=0.1.0.r1.g2121826
pkgrel=1
pkgdesc="Motorola Moto Buds companion CLI and Qt6/QML desktop application (VCS master)"
arch=('x86_64')
url="https://github.com/Shnimlz/moto-buds-linux"
license=('MIT')
depends=(
    'qt6-base'
    'qt6-declarative'
    'qt6-quickcontrols2'
    'bluez'
    'hicolor-icon-theme'
)
makedepends=(
    'git'
    'cargo'
    'rust'
    'cmake'
    'ninja'
    'gcc'
)
provides=('moto-buds' 'moto-buds-gui')
conflicts=('moto-buds' 'moto-buds-bin' 'moto-buds-appimage')
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/moto-buds-linux"
    git describe --long --tags 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' || \
    printf "0.1.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cd "$srcdir/moto-buds-linux"
    cargo build --release
    cmake -B build -S . -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -G Ninja
    ninja -C build
}

package() {
    cd "$srcdir/moto-buds-linux"
    DESTDIR="$pkgdir" ninja -C build install
    install -Dm755 target/release/moto-buds "$pkgdir/usr/bin/moto-buds"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
